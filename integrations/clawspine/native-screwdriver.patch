+    value = root.GetAttribute("envcreator:wristTool").Get()
+    if not value:
+        return
+    spec = json.loads(value)
+    if spec.get("schema") != "envcreator.wrist-tool.v1" or spec.get("robot_link") != "right_wrist_yaw_link":
+        raise ValueError("Unsupported explicit wrist tool mount")
+    asset = root.GetAttribute("envcreator:wristToolAsset").Get()
+    if not asset or not asset.resolvedPath:
+        raise ValueError("Wrist tool asset must resolve inside the scene package")
+    asset_path = str(Path(asset.resolvedPath).resolve())
+    if not Path(asset_path).is_relative_to(Path(scene_path).resolve().parent):
+        raise ValueError("Wrist tool must be inside the mounted scene package")
+    mechanics_enabled = bool(root.GetAttribute("envcreator:nativeScrewMechanics").Get())
+    original_spawn = cfg.scene.robot.spawn.func
+
+    def spawn_with_tool(prim_path, spawn_cfg, *args, **kwargs):
+        robot = original_spawn(prim_path, spawn_cfg, *args, **kwargs)
+        import omni.usd
+        stage = omni.usd.get_context().get_stage()
+        wrist = stage.GetPrimAtPath(str(robot.GetPath()) + "/" + spec["robot_link"])
+        if not wrist:
+            raise ValueError("Wrist tool requires the declared loaded robot link")
+        tool = UsdGeom.Xform.Define(stage, "/World/WristTool")
+        tool.GetPrim().GetReferences().AddReference(asset_path)
+        if mechanics_enabled:
+            # Author exclusions before PhysX parses the scene; the coupling replaces contact.
+            for body in ("housing", "spindle"):
+                UsdPhysics.FilteredPairsAPI.Apply(stage.GetPrimAtPath("/World/WristTool/" + body)).CreateFilteredPairsRel().AddTarget(Sdf.Path(BACKGROUND_PATH + "/TargetScrew"))
+        q = spec["mount_rotation_wxyz"]
+        rotation = Gf.Quatd(q[0], Gf.Vec3d(*q[1:]))
+        local = Gf.Matrix4d().SetRotate(rotation)
+        local.SetTranslateOnly(Gf.Vec3d(*spec["mount_position_m"]))
+        world = local * UsdGeom.Xformable(wrist).ComputeLocalToWorldTransform(0)
+        tool.ClearXformOpOrder()
+        tool.AddTransformOp().Set(world)
+        housing = stage.GetPrimAtPath("/World/WristTool/" + spec["tool_body"])
+        if not housing or not housing.HasAPI(UsdPhysics.RigidBodyAPI):
+            raise ValueError("Wrist tool housing is not a rigid body")
+        joint = UsdPhysics.FixedJoint.Define(stage, "/World/WristToolMount")
+        joint.CreateBody0Rel().SetTargets([wrist.GetPath()])
+        joint.CreateBody1Rel().SetTargets([housing.GetPath()])
+        joint.CreateLocalPos0Attr(Gf.Vec3f(*spec["mount_position_m"]))
+        joint.CreateLocalRot0Attr(Gf.Quatf(q[0], Gf.Vec3f(*q[1:])))
+        joint.CreateLocalPos1Attr(Gf.Vec3f(0))
+        joint.CreateLocalRot1Attr(Gf.Quatf(1))
+        joint.CreateExcludeFromArticulationAttr(True)
+        joint.CreateCollisionEnabledAttr(False)
+        if spec.get("hide_right_hand"):
+            for prim in Usd.PrimRange(robot):
+                name = prim.GetName()
+                hand = name.startswith("right_hand_") or name == "right_rubber_hand"
+                wrist_shapes = prim.GetParent() == wrist and name in {"visuals", "collisions"}
+                if hand or wrist_shapes:
+                    UsdGeom.Imageable(prim).MakeInvisible()
+                    for child in Usd.PrimRange(prim):
+                        if child.HasAPI(UsdPhysics.CollisionAPI):
+                            UsdPhysics.CollisionAPI(child).CreateCollisionEnabledAttr(False)
+        return robot
+
+    cfg.scene.robot.spawn.func = spawn_with_tool
