+def configure_wrist_tool(cfg, scene_path):
+    """Optional explicit scene-authored fixed wrist tool, composed before PhysX.
+
+    Keeps the controller's robot articulation unchanged. The tool retains its
+    own articulation; an excluded fixed joint carries its loads to the wrist.
+    No per-step pose writes or simulated grasp are used.
+    """
+    if not scene_path:
+        return
+    from pxr import Gf, Sdf, Usd, UsdGeom, UsdPhysics
+    source = Usd.Stage.Open(str(scene_path))
+    root = source.GetDefaultPrim()
+    controller_dir = root.GetAttribute("envcreator:controllerModelDirectory").Get()
+    if controller_dir:
+        directory = Path(controller_dir).resolve()
+        if not directory.is_relative_to(Path("/runtime-cache")) or not (directory / "g1_29dof_with_hand.urdf").is_file():
+            raise ValueError("Declared controller resource directory is unavailable")
+        from isaaclab_arena_g1.g1_whole_body_controller.wbc_policy.utils import g1 as model_resources
