+        def retrieve_controller_resource(path, *args, **kwargs):
+            if path == remote:
+                return str(directory)
+            if path == remote + "g1_29dof_with_hand.urdf":
+                return str(directory / "g1_29dof_with_hand.urdf")
+            for name in ("stand.onnx", "walk.onnx"):
+                if path == model_resources.ISAACLAB_NUCLEUS_DIR + "/Arena/wbc_policy/models/homie_v2/" + name:
+                    local = directory / name
+                    if not local.is_file():
+                        raise ValueError("Declared local Homie model is unavailable: " + name)
+                    return str(local)
+            return original_retrieve(path, *args, **kwargs)
+
+        model_resources.retrieve_file_path = retrieve_controller_resource
+        g1_homie_policy.retrieve_file_path = retrieve_controller_resource
+    robot_asset = root.GetAttribute("envcreator:robotAsset").Get()
+    if robot_asset:
+        if not robot_asset.resolvedPath or not Path(robot_asset.resolvedPath).resolve().is_relative_to(Path(scene_path).resolve().parent):
+            raise ValueError("Declared robot asset must resolve inside the scene package")
